# ---------------------------------------------------------------
# JenCorps Influencer Platform - backend environment
# Copy to backend/.env (or the repo root .env) and fill in values.
# NEVER commit real secrets.
# ---------------------------------------------------------------
NODE_ENV=development
PORT=5000

# MongoDB (Atlas in production). A replica set (Atlas always is) enables transactions.
MONGODB_URI=mongodb://127.0.0.1:27017/jencorps

# Long random strings (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
COOKIE_SECRET=
# Used to encrypt influencer payout details (bank account / UPI) at rest
DATA_ENCRYPTION_KEY=

# Public site
FRONTEND_URL=https://jencorps.com
BASE_DOMAIN=jencorps.com
# Extra comma-separated CORS origins (optional)
CORS_ORIGINS=
# Number of reverse proxies in front of the API (Nginx = 1)
TRUST_PROXY=1

# Razorpay (backend only - never expose the secret to React)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# In development, when Razorpay keys are empty a mock gateway is used automatically.
# Set to false to disable it. It can never be enabled in production.
PAYMENT_MOCK=

# SMTP (Nodemailer). When SMTP_HOST is empty, emails are printed to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="JenCorps <no-reply@jencorps.com>"

# Cloudinary. When empty, uploads are stored on local disk in backend/uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Public URL that serves backend /uploads when using local storage (optional)
PUBLIC_API_URL=
